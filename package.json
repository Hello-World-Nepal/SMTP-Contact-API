{
  "name": "smtp-contact-api",
  "version": "1.0.0",
  "description": "Lightweight Express API that forwards contact form submissions via SMTP. Drop-in Formspree replacement for self-hosted setups.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["contact-form", "smtp", "nodemailer", "express", "self-hosted"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "nodemailer": "^8.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
