# SMTP settings
SMTP_HOST=arrow.mxroute.com        # Your SMTP server hostname
SMTP_PORT=587                       # 587 = STARTTLS, 465 = SSL
SMTP_SECURE=false                   # true only if using port 465
SMTP_USER=contact@yourdomain.com    # SMTP login (usually the sending address)
SMTP_PASS=your_smtp_password

# Email routing
CONTACT_RECIPIENT=contact@yourdomain.com   # Where to deliver form submissions
FROM_NAME=Contact Form                     # Display name in the From header

# Server
PORT=3001                           # Port the API listens on

# CORS — comma-separated list of allowed frontend origins, or * for any
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
